data/checkpoints/*test*.nexa
data/checkpoints/*_final.nexa
data/checkpoints/nexa_nano_step_30.nexa
data/checkpoints/nexa_nano_corpus_step_60.nexa
data/checkpoints/nexa_nano_qa.nexa
data/checkpoints/nexa_p36_tier1*
data/checkpoints/nexa_p36_tier2*
data/checkpoints/nexa_p36_tier3_best.nexa
data/checkpoints/nexa_phase35_nano*
