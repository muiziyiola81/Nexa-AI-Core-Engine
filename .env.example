# ==============================================================================
# NEXA AI Core Engine - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Standalone Backend Mode (Set to true for headless Cloud Run / Docker / Termux API)
STANDALONE_API=false

# Active Inference Runtime Adapter ("nexa-native" | "llama-cpp" | "nexa-diagnostic")
ACTIVE_ADAPTER=nexa-native
NEXA_CPP_BINARY_PATH=

# Storage Paths (Override DATA_DIR / MODELS_DIR for Cloud Run GCS FUSE or external volumes)
MODELS_DIR=./models
DATA_DIR=./data

# Startup & Checkpoint Lifecycle Controls
AUTO_REGISTER_NEXA_CHECKPOINTS=true
AUTO_LOAD_MODELS=nexa-p36-tier3
AUTO_LOAD_ON_DEMAND=true
REQUIRE_LOADED_MODEL_FOR_READY=false

# Optional Local llama.cpp Runtime Configuration
LLAMA_CPP_SERVER_URL=http://127.0.0.1:8080
NEXA_LLAMA_CPP_PATH=

# API Security & Authentication
# In Cloud Run, set REQUIRE_API_KEY=true and provide NEXA_API_KEY via Secret Manager
REQUIRE_API_KEY=false
NEXA_API_KEY=
MASTER_API_KEY=nexa_live_dev_master_key_local
NEXA_API_KEYS=

# CORS Configuration (Comma-separated origins for separate NEXA AI frontend app, or *)
ALLOWED_ORIGINS=*

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=4
MAX_TOKENS_PER_REQUEST=4096

# Hardware Execution Defaults
DEFAULT_CONTEXT_WINDOW=4096
DEFAULT_CPU_THREADS=4
DEFAULT_GPU_LAYERS=0
EXECUTION_BACKEND=auto

# Frontend Client API Target (Used when running React frontend separately from backend)
VITE_BACKEND_URL=http://localhost:3000
